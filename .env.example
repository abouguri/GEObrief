# Copy to .env.local and fill in. Never commit .env.local.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only. Bypasses RLS — required for the usage gate and the Gumroad
# webhook to write to the users table. Must NOT be prefixed NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Groq (inference + built-in web search) ──────────────────────────────────
# https://console.groq.com — free tier, no credit card. Server-side only.
# NOTE: Groq (groq.com) is not Grok (xAI). We use Groq's `compound` system
# because web search is built in and runs automatically, which is what makes
# the "sources currently ranking" section real rather than invented.
GROQ_API_KEY=your_groq_api_key
# Optional override. compound = full search + reasoning, compound-mini = faster.
GROQ_MODEL=groq/compound

# ── App ─────────────────────────────────────────────────────────────────────
# No trailing slash. Used for canonical URLs, sitemap, and OAuth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=hello@geobrief.ai

# ── Gumroad ─────────────────────────────────────────────────────────────────
# Shared secret you invent yourself, then append to the Ping URL you register
# in Gumroad (Settings -> Advanced -> Ping):
#   https://yourdomain.com/api/webhooks/gumroad?secret=THIS_VALUE
# Gumroad Ping is not signed, so this secret is the only credential — treat the
# whole ping URL as sensitive. Generate one with: openssl rand -hex 32
GUMROAD_SECRET_KEY=generate_a_long_random_string

# Checkout links shown in the UI.
NEXT_PUBLIC_GUMROAD_PRO_URL=https://yourname.gumroad.com/l/geobrief-pro
NEXT_PUBLIC_GUMROAD_LIFETIME_URL=https://yourname.gumroad.com/l/geobrief-lifetime

# Optional. The lifetime product's permalink (the part after /l/), used to tell
# a lifetime purchase from a Pro subscription. Falls back to detecting whether
# the sale is recurring.
GUMROAD_LIFETIME_PERMALINK=geobrief-lifetime

# Optional. Your Gumroad seller id — pings from other sellers are ignored.
GUMROAD_SELLER_ID=

# ── Optional: analytics ─────────────────────────────────────────────────────
NEXT_PUBLIC_ANALYTICS_ID=
